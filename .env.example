OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Absolute path to the directory containing KVS member avatars.
KVS_AVATAR_ROOT=/var/www/theync.com/contents/avatars

# Keep service data outside the public web root.
MODERATOR_STORAGE_ROOT=/var/lib/kvs-avatar-moderator
POLICY_VIOLATION_IMAGE=/var/www/kvs-avatar-moderator/current/assets/avatar-policy-violation.png
PENDING_REVIEW_IMAGE=/var/www/kvs-avatar-moderator/current/assets/avatar-under-review.png

MAX_IMAGE_BYTES=5242880
MAX_IMAGE_DIMENSION=4096
OUTPUT_IMAGE_SIZE=512
JPEG_QUALITY=88
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
SCAN_LIMIT=100

# Zone-scoped token with only Cache Purge permission for the KVS zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
PUBLIC_BASE_URL=https://theync.com

# All image-supported categories returned as flagged by OpenAI are blocked.
BLOCK_ON_MODEL_FLAGGED=true
BLOCKED_CATEGORIES=sexual,sexual/minors,violence,violence/graphic,self-harm,self-harm/instructions,self-harm/intent

# Required only when using public/moderate.php from a KVS custom block.
KVS_HOOK_SECRET=
HOOK_MAX_CLOCK_SKEW_SECONDS=300
